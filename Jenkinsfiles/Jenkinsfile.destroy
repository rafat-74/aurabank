// ============================================================
// AuraBank — Pipeline 3: Destroy (هد كل حاجة)
// مع Manual Approval قبل التنفيذ
// ============================================================
pipeline {
    agent any

    environment {
        AWS_REGION     = 'us-east-1'
        AWS_ACCOUNT_ID = '816709079108'
        ENV            = 'dev'
        PROJECT        = 'aurabank'
        TF_DIR         = 'terraform/envs/dev'
        STATE_BUCKET   = 'aurabank-terraform-state-dev'
        LOCK_TABLE     = 'aurabank-terraform-locks-dev'
    }

    stages {

        // ── 1. Install Dependencies ────────────────────────────
        stage('Install Dependencies') {
            steps {
                sh '''
                    echo "=== Checking dependencies ==="

                    # AWS CLI
                    if command -v aws &>/dev/null; then
                        echo "AWS CLI already installed: $(aws --version)"
                    else
                        echo "Installing AWS CLI..."
                        sudo rm -rf /tmp/aws /tmp/awscliv2.zip
                        curl -fsSL "https://awscli.amazonaws.com/awscli-exe-linux-x86_64.zip" -o /tmp/awscliv2.zip
                        unzip -q /tmp/awscliv2.zip -d /tmp
                        sudo /tmp/aws/install --update
                        sudo rm -rf /tmp/aws /tmp/awscliv2.zip
                        echo "AWS CLI installed: $(aws --version)"
                    fi

                    # Terraform
                    if command -v terraform &>/dev/null; then
                        echo "Terraform already installed: $(terraform version -json | python3 -c 'import sys,json; print(json.load(sys.stdin)["terraform_version"])')"
                    else
                        echo "Installing Terraform..."
                        curl -fsSL "https://releases.hashicorp.com/terraform/1.7.5/terraform_1.7.5_linux_amd64.zip" \
                            -o /tmp/terraform.zip
                        sudo unzip -q /tmp/terraform.zip -d /usr/local/bin
                        sudo chmod +x /usr/local/bin/terraform
                        rm -f /tmp/terraform.zip
                        echo "Terraform installed"
                    fi
                    terraform --version

                    echo "✅ Dependencies ready"
                '''
            }
        }

        // ── 2. Checkout ────────────────────────────────────────
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        // ── 3. Show What Will Be Destroyed ────────────────────
        stage('Show Resources') {
            steps {
                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding', credentialsId: 'aws-creds']
                ]) {
                sh '''
                    echo "======================================"
                    echo "⚠️  RESOURCES THAT WILL BE DESTROYED"
                    echo "======================================"

                    echo ""
                    echo "--- ECS Services ---"
                    aws ecs list-services \
                        --cluster aurabank-dev-cluster \
                        --region ${AWS_REGION} \
                        --query 'serviceArns[*]' \
                        --output table 2>/dev/null || echo "No ECS services found"

                    echo ""
                    echo "--- ECR Repositories ---"
                    aws ecr describe-repositories \
                        --region ${AWS_REGION} \
                        --query 'repositories[?contains(repositoryName, `aurabank`)].repositoryName' \
                        --output table 2>/dev/null || echo "No ECR repos found"

                    echo ""
                    echo "--- RDS Instances ---"
                    aws rds describe-db-instances \
                        --region ${AWS_REGION} \
                        --query 'DBInstances[?contains(DBInstanceIdentifier, `aurabank`)].DBInstanceIdentifier' \
                        --output table 2>/dev/null || echo "No RDS found"

                    echo ""
                    echo "--- Load Balancers ---"
                    aws elbv2 describe-load-balancers \
                        --region ${AWS_REGION} \
                        --query 'LoadBalancers[?contains(LoadBalancerName, `aurabank`)].LoadBalancerName' \
                        --output table 2>/dev/null || echo "No ALBs found"

                    echo ""
                    echo "======================================"
                    echo "⚠️  ALL OF THE ABOVE WILL BE DELETED!"
                    echo "======================================"
                '''
                }
            }
        }

        // ── 4. MANUAL APPROVAL ─────────────────────────────────
        stage('Manual Approval') {
            steps {
                script {
                    timeout(time: 30, unit: 'MINUTES') {
                        input(
                            message: 'تحذير: هل انت متاكد انك عايز تمسح كل الـ infrastructure؟ اضغط OK للمتابعة او Abort للالغاء.',
                            ok: 'نعم، امسح كل حاجة',
                            submitter: 'admin'
                        )
                    }
                    echo '✅ Confirmed — proceeding with destruction'
                }
            }
        }

        // ── 5. Stop ECS Services ───────────────────────────────
        stage('Stop ECS Services') {
            steps {
                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding', credentialsId: 'aws-creds']
                ]) {
                sh '''
                    echo "=== Stopping ECS Services ==="
                    SERVICES="api-gateway auth-service accounts-service transactions-service notifications-service frontend-customers frontend-teller"
                    CLUSTER="aurabank-dev-cluster"

                    # Step 1: Set desired count to 0
                    for svc in $SERVICES; do
                        aws ecs update-service \
                            --cluster ${CLUSTER} \
                            --service aurabank-dev-${svc} \
                            --desired-count 0 \
                            --region ${AWS_REGION} > /dev/null 2>&1 || true
                        echo "  down: aurabank-dev-${svc}"
                    done

                    # Step 2: Force-stop any still-running tasks
                    echo "=== Force-stopping running tasks ==="
                    TASK_ARNS=$(aws ecs list-tasks \
                        --cluster ${CLUSTER} \
                        --region ${AWS_REGION} \
                        --query "taskArns[*]" \
                        --output text 2>/dev/null || true)

                    if [ -n "$TASK_ARNS" ]; then
                        for task in $TASK_ARNS; do
                            aws ecs stop-task \
                                --cluster ${CLUSTER} \
                                --task "$task" \
                                --region ${AWS_REGION} > /dev/null 2>&1 || true
                            echo "  stopped: $task"
                        done
                    else
                        echo "  No running tasks found"
                    fi

                    # Step 3: Wait until all tasks are drained (max 2 min)
                    echo "=== Waiting for all tasks to drain ==="
                    WAITED=0
                    while [ $WAITED -lt 120 ]; do
                        COUNT=$(aws ecs list-tasks \
                            --cluster ${CLUSTER} \
                            --region ${AWS_REGION} \
                            --query "length(taskArns)" \
                            --output text 2>/dev/null || echo "0")
                        if [ "$COUNT" = "0" ] || [ "$COUNT" = "None" ]; then
                            echo "  All tasks stopped"
                            break
                        fi
                        echo "  ${COUNT} tasks still running... (${WAITED}s)"
                        sleep 10
                        WAITED=$((WAITED + 10))
                    done

                    echo "ECS services fully stopped"
                '''
                }
            }
        }

        // ── 6. Clear ECR Images ────────────────────────────────
        stage('Clear ECR Images') {
            steps {
                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding', credentialsId: 'aws-creds']
                ]) {
                sh '''
                    echo "=== Clearing ECR Images ==="
                    REPOS="accounts-service api-gateway auth-service transactions-service notifications-service frontend-customers frontend-teller"

                    for repo in $REPOS; do
                        FULL_REPO="aurabank/dev/${repo}"
                        IMAGE_IDS=$(aws ecr list-images \
                            --repository-name "$FULL_REPO" \
                            --region ${AWS_REGION} \
                            --query 'imageIds[*]' \
                            --output json 2>/dev/null || echo "[]")

                        if [ "$IMAGE_IDS" = "[]" ] || [ "$IMAGE_IDS" = "null" ]; then
                            echo "  ${repo}: no images"
                            continue
                        fi

                        aws ecr batch-delete-image \
                            --repository-name "$FULL_REPO" \
                            --image-ids "$IMAGE_IDS" \
                            --region ${AWS_REGION} > /dev/null 2>&1 || true
                        echo "  ${repo}: images deleted"
                    done

                    echo "✅ ECR cleared"
                '''
                }
            }
        }

        // ── 7. Build Lambda Zip (needed for filebase64sha256) ────
        stage('Build Lambda Zip') {
            steps {
                sh '''
                    echo "=== Creating Lambda zip for Terraform destroy ==="
                    ZIP_PATH="terraform/modules/rds/db_init_lambda.zip"
                    if [ ! -f "$ZIP_PATH" ]; then
                        echo "placeholder" > /tmp/placeholder.py
                        zip -j "$ZIP_PATH" /tmp/placeholder.py
                        echo "  Created dummy zip"
                    else
                        echo "  Zip already exists"
                    fi
                    echo "✅ Lambda zip ready"
                '''
            }
        }

        stage('Terraform Init') {
            steps {
                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding', credentialsId: 'aws-creds'],
                    file(credentialsId: 'terraform-tfvars-dev', variable: 'TFVARS_FILE')
                ]) {
                    sh '''
                        echo "=== Terraform Init ==="

                        # ── Ensure S3 backend bucket exists ───────────────
                        if ! aws s3api head-bucket                             --bucket "${STATE_BUCKET}"                             --region ${AWS_REGION} 2>/dev/null; then
                            echo "  S3 bucket not found — creating..."
                            aws s3api create-bucket                                 --bucket "${STATE_BUCKET}"                                 --region ${AWS_REGION}                                 --output text
                            aws s3api put-bucket-versioning                                 --bucket "${STATE_BUCKET}"                                 --versioning-configuration Status=Enabled                                 --region ${AWS_REGION}
                            echo "  Waiting for bucket propagation..."
                            sleep 10
                            echo "  S3 bucket ready: ${STATE_BUCKET}"
                        else
                            echo "  S3 bucket exists: ${STATE_BUCKET}"
                        fi

                        # ── Ensure DynamoDB lock table exists ─────────────
                        if ! aws dynamodb describe-table                             --table-name "${LOCK_TABLE}"                             --region ${AWS_REGION} > /dev/null 2>&1; then
                            echo "  DynamoDB table not found — creating..."
                            aws dynamodb create-table                                 --table-name "${LOCK_TABLE}"                                 --attribute-definitions AttributeName=LockID,AttributeType=S                                 --key-schema AttributeName=LockID,KeyType=HASH                                 --billing-mode PAY_PER_REQUEST                                 --region ${AWS_REGION} > /dev/null
                            echo "  DynamoDB table ready: ${LOCK_TABLE}"
                        else
                            echo "  DynamoDB table exists: ${LOCK_TABLE}"
                        fi

                        cd ${TF_DIR}
                        rm -f terraform.tfvars && cp "$TFVARS_FILE" terraform.tfvars
                        sudo rm -rf ../../modules/rds/db_init_build 2>/dev/null || true

                        mkdir -p $HOME/.terraform.d/plugin-cache
                        export TF_PLUGIN_CACHE_DIR="$HOME/.terraform.d/plugin-cache"

                        terraform init -reconfigure || \
                        terraform init -reconfigure -lock=false
                        echo "✅ Terraform initialized"
                    '''
                }
            }
        }

        // ── 9. Terraform Destroy ───────────────────────────────
        stage('Terraform Destroy') {
            steps {
                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding', credentialsId: 'aws-creds'],
                    file(credentialsId: 'terraform-tfvars-dev', variable: 'TFVARS_FILE')
                ]) {
                    sh '''#!/bin/bash
                        echo "=== Terraform Destroy ==="
                        cd ${TF_DIR}
                        rm -f terraform.tfvars && cp "$TFVARS_FILE" terraform.tfvars

                        # ── Check if state has any resources to destroy ───
                        RESOURCE_COUNT=$(terraform show -json 2>/dev/null | \
                            python3 -c "
import sys, json
try:
    data = json.load(sys.stdin)
    vals = data.get('values', {})
    resources = vals.get('root_module', {}).get('resources', [])
    child = vals.get('root_module', {}).get('child_modules', [])
    total = len(resources)
    for m in child:
        total += len(m.get('resources', []))
    print(total)
except:
    print(0)
" 2>/dev/null || echo "0")

                        echo "  Resources in state: ${RESOURCE_COUNT}"

                        if [ "${RESOURCE_COUNT}" = "0" ]; then
                            echo "⚠️  State is empty — nothing to destroy via Terraform"
                            echo "   Running manual AWS cleanup instead..."

                            # Manual cleanup for resources not in state
                            CLUSTER="aurabank-${ENV}-cluster"
                            SERVICES="api-gateway auth-service accounts-service transactions-service notifications-service frontend-customers frontend-teller"

                            for svc in $SERVICES; do
                                aws ecs update-service --cluster $CLUSTER                                     --service aurabank-${ENV}-${svc}                                     --desired-count 0 --region ${AWS_REGION} > /dev/null 2>&1 || true
                                aws ecs delete-service --cluster $CLUSTER                                     --service aurabank-${ENV}-${svc}                                     --force --region ${AWS_REGION} > /dev/null 2>&1 &&                                     echo "  Deleted service: ${svc}" || true
                            done
                            aws ecs delete-cluster --cluster $CLUSTER                                 --region ${AWS_REGION} > /dev/null 2>&1 && echo "  Deleted cluster" || true

                            aws rds delete-db-instance                                 --db-instance-identifier aurabank-${ENV}-rds                                 --skip-final-snapshot                                 --region ${AWS_REGION} > /dev/null 2>&1 && echo "  Deleting RDS..." || true

                            ALB_ARN=$(aws elbv2 describe-load-balancers --region ${AWS_REGION}                                 --query "LoadBalancers[?contains(LoadBalancerName,`aurabank`)].LoadBalancerArn"                                 --output text 2>/dev/null)
                            [ -n "$ALB_ARN" ] && aws elbv2 delete-load-balancer                                 --load-balancer-arn $ALB_ARN --region ${AWS_REGION} > /dev/null 2>&1 &&                                 echo "  Deleted ALB" || true

                            aws lambda delete-function --function-name aurabank-${ENV}-db-init                                 --region ${AWS_REGION} > /dev/null 2>&1 && echo "  Deleted Lambda" || true

                            for repo in api-gateway auth-service accounts-service transactions-service notifications-service frontend-customers frontend-teller; do
                                aws ecr delete-repository --repository-name aurabank/${repo}                                     --force --region ${AWS_REGION} > /dev/null 2>&1 &&                                     echo "  Deleted ECR: ${repo}" || true
                            done

                            for secret in auth accounts transactions notifications master; do
                                aws secretsmanager delete-secret                                     --secret-id aurabank/${ENV}/rds/${secret}                                     --force-delete-without-recovery                                     --region ${AWS_REGION} > /dev/null 2>&1 &&                                     echo "  Deleted secret: ${secret}" || true
                            done
                            aws secretsmanager delete-secret                                 --secret-id aurabank/${ENV}/jwt-secret                                 --force-delete-without-recovery                                 --region ${AWS_REGION} > /dev/null 2>&1 && echo "  Deleted: jwt-secret" || true

                            QUEUE_URL=$(aws sqs get-queue-url                                 --queue-name aurabank-${ENV}-notifications                                 --region ${AWS_REGION}                                 --query 'QueueUrl' --output text 2>/dev/null || true)
                            [ -n "$QUEUE_URL" ] && aws sqs delete-queue                                 --queue-url $QUEUE_URL --region ${AWS_REGION} > /dev/null 2>&1 &&                                 echo "  Deleted SQS" || true

                            # Target Groups
                            for tg in api customers teller; do
                                TG_ARN=$(aws elbv2 describe-target-groups \
                                    --names aurabank-${ENV}-tg-${tg} \
                                    --region ${AWS_REGION} \
                                    --query 'TargetGroups[0].TargetGroupArn' \
                                    --output text 2>/dev/null || true)
                                [ -n "$TG_ARN" ] && [ "$TG_ARN" != "None" ] && \
                                    aws elbv2 delete-target-group \
                                        --target-group-arn $TG_ARN \
                                        --region ${AWS_REGION} > /dev/null 2>&1 && \
                                    echo "  Deleted TG: aurabank-${ENV}-tg-${tg}" || true
                            done

                            # RDS Subnet Group
                            aws rds delete-db-subnet-group \
                                --db-subnet-group-name aurabank-${ENV}-db-subnet-group \
                                --region ${AWS_REGION} > /dev/null 2>&1 && \
                                echo "  Deleted RDS subnet group" || true

                            # CloudWatch Log Groups
                            for lg in \
                                "/aws/ecs/containerinsights/aurabank-${ENV}-cluster/performance" \
                                "/aws/rds/instance/aurabank-${ENV}-rds/postgresql" \
                                "/aurabank/${ENV}/vpc-flow-logs" \
                                "aws-waf-logs-aurabank-${ENV}-customers" \
                                "aws-waf-logs-aurabank-${ENV}-teller"; do
                                aws logs delete-log-group \
                                    --log-group-name "$lg" \
                                    --region ${AWS_REGION} > /dev/null 2>&1 && \
                                    echo "  Deleted log group: $lg" || true
                            done

                            # S3 Log Buckets
                            ACCOUNT_ID=$(aws sts get-caller-identity \
                                --query Account --output text)
                            for bucket in \
                                "aurabank-${ENV}-alb-logs-${ACCOUNT_ID}" \
                                "aurabank-${ENV}-cf-logs-${ACCOUNT_ID}"; do
                                aws s3 rm s3://${bucket} --recursive \
                                    --region ${AWS_REGION} > /dev/null 2>&1 || true
                                aws s3api delete-bucket \
                                    --bucket ${bucket} \
                                    --region ${AWS_REGION} > /dev/null 2>&1 && \
                                    echo "  Deleted S3: ${bucket}" || true
                            done

                            # Elastic IPs (unassociated)
                            EIPS=$(aws ec2 describe-addresses \
                                --region ${AWS_REGION} \
                                --filters Name=domain,Values=vpc \
                                --query 'Addresses[?AssociationId==null].AllocationId' \
                                --output text 2>/dev/null || true)
                            for eip in $EIPS; do
                                aws ec2 release-address \
                                    --allocation-id $eip \
                                    --region ${AWS_REGION} > /dev/null 2>&1 && \
                                    echo "  Released EIP: $eip" || true
                            done

                        else
                            echo "  Running terraform destroy on ${RESOURCE_COUNT} resources..."
                            if ! terraform destroy \
                                -var-file=terraform.tfvars \
                                -var="image_tag=latest" \
                                -auto-approve; then
                                echo "Terraform destroy had errors — trying with -lock=false"
                                terraform destroy \
                                    -var-file=terraform.tfvars \
                                    -var="image_tag=latest" \
                                    -auto-approve \
                                    -lock=false
                            fi
                        fi
                        echo "✅ Infrastructure destroyed"
                    '''
                }
            }
        }

        // ── 10. Delete S3 State Bucket ──────────────────────────
        stage('Delete State Bucket') {
            steps {
                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding', credentialsId: 'aws-creds']
                ]) {
                sh '''
                    echo "=== Deleting S3 State Bucket ==="
                    BUCKET="${STATE_BUCKET}"

                    if ! aws s3api head-bucket --bucket "$BUCKET" --region ${AWS_REGION} 2>/dev/null; then
                        echo "Bucket does not exist — skipping"
                    else
                        for TYPE in Versions DeleteMarkers; do
                            ITEMS=$(aws s3api list-object-versions \
                                --bucket "$BUCKET" \
                                --region ${AWS_REGION} \
                                --query "${TYPE}[].{Key:Key,VersionId:VersionId}" \
                                --output json 2>/dev/null || echo "[]")

                            if [ "$ITEMS" != "[]" ] && [ "$ITEMS" != "null" ]; then
                                DELETE_PAYLOAD=$(echo "$ITEMS" | python3 -c "
import json,sys
items=json.load(sys.stdin)
print(json.dumps({'Objects':items,'Quiet':True}))
")
                                aws s3api delete-objects \
                                    --bucket "$BUCKET" \
                                    --delete "$DELETE_PAYLOAD" \
                                    --region ${AWS_REGION} >/dev/null 2>&1 || true
                                echo "  Deleted $TYPE"
                            fi
                        done

                        aws s3api delete-bucket \
                            --bucket "$BUCKET" \
                            --region ${AWS_REGION} 2>/dev/null || true
                        echo "✅ State bucket deleted"
                    fi
                '''
                }
            }
        }

        // ── 11. Delete DynamoDB Lock Table ─────────────────────
        stage('Delete Lock Table') {
            steps {
                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding', credentialsId: 'aws-creds']
                ]) {
                    sh '''
                        echo "=== Deleting DynamoDB Lock Table ==="
                        aws dynamodb delete-table \
                            --table-name ${LOCK_TABLE} \
                            --region ${AWS_REGION} 2>/dev/null || \
                        echo "Lock table does not exist or already deleted"
                        echo "✅ Lock table deleted"
                    '''
                }
            }
        }

        // ── 12. Verify Destruction ─────────────────────────────
        stage('Verify Destruction') {
            steps {
                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding', credentialsId: 'aws-creds']
                ]) {
                sh '''
                    echo "=== Verifying Destruction ==="

                    CLUSTER_STATUS=$(aws ecs describe-clusters \
                        --clusters aurabank-dev-cluster \
                        --region ${AWS_REGION} \
                        --query 'clusters[0].status' \
                        --output text 2>/dev/null || echo "INACTIVE")
                    echo "ECS Cluster: ${CLUSTER_STATUS}"

                    RDS_COUNT=$(aws rds describe-db-instances \
                        --region ${AWS_REGION} \
                        --query 'length(DBInstances[?contains(DBInstanceIdentifier, `aurabank`)])' \
                        --output text 2>/dev/null || echo "0")
                    echo "RDS Instances: ${RDS_COUNT}"

                    NAT_COUNT=$(aws ec2 describe-nat-gateways \
                        --filter "Name=state,Values=available" \
                        --region ${AWS_REGION} \
                        --query 'length(NatGateways[?contains(Tags[?Key==`Project`].Value, `aurabank`)])' \
                        --output text 2>/dev/null || echo "0")
                    echo "NAT Gateways still active: ${NAT_COUNT}"

                    echo ""
                    echo "======================================"
                    echo "DESTRUCTION COMPLETE"
                    echo "   Account: ${AWS_ACCOUNT_ID}"
                    echo "   Region:  ${AWS_REGION}"
                    echo "   Env:     ${ENV}"
                    echo "======================================"
                '''
                }
            }
        }
    }

    post {
        success {
            echo 'Infrastructure successfully destroyed!'
        }
        failure {
            sh '''
                echo "Destroy pipeline failed!"
                echo "Check logs — some resources might still exist"
                echo "Run manually: cd terraform/envs/dev && terraform destroy -var-file=terraform.tfvars -lock=false"
            '''
        }
        always {
            // Cleanup any leftover build artifacts and temp files
            sh '''
                sudo rm -rf terraform/modules/rds/db_init_build 2>/dev/null || true
                rm -f /tmp/destroy-output.txt || true
                rm -f terraform/envs/dev/terraform.tfvars || true
            '''
        }
    }
}
